; Engine configuration file.
; Wild Survival - 3D wildlife survival game (Godot 4.7)

config_version=5

[application]

config/name="Wild Survival"
config/description="Survive as a deer in a dense jungle stalked by lions, tigers, cheetahs and hyenas."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.04, 0.06, 0.04, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/size/borderless=false
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="obstacles"
3d_physics/layer_3="player"
3d_physics/layer_4="predators"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=3
occlusion_culling/use_occlusion_culling=true
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=2
textures/vram_compression/import_etc2_astc=false
